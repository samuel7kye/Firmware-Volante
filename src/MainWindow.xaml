    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="PageViewport" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" Padding="24,0,24,0">
