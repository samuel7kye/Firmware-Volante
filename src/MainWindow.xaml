    <Grid x:Name="HomePage" MinHeight="600">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="54"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="22,24"><StackPanel><TextBlock Text="CONFIGURAÇÃO" Foreground="#607187" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Force feedback" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,7"/><TextBlock Text="Intensidade e resposta do motor." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/><StackPanel x:Name="ForceControls"/><Border Height="1" Background="#222C39" Margin="0,4,0,18"/><TextBlock Text="LIMITE DE DIREÇÃO" Foreground="#607187" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel x:Name="StopControls"/><TextBlock Text="Os ajustes são enviados ao clicar em Aplicar ao volante." FontSize="10" LineHeight="16" TextWrapping="Wrap" Foreground="#64758A" Margin="0,12,0,0"/></StackPanel></Border>
