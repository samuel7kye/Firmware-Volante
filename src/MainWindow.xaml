    <Grid x:Name="ProfilesPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Perfis salvos" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Selecione um perfil para carregar os ajustes." Foreground="{StaticResource Muted}" Margin="0,8,0,24"/></StackPanel><ListBox x:Name="ProfileList" Grid.Row="1" DisplayMemberPath="Name"/><Button x:Name="LoadProfile" Grid.Row="2" Content="Carregar perfil selecionado" Margin="0,18,0,0"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Salvar configuração" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Nome do perfil" Foreground="#9AAABE" Margin="0,24,0,9"/><TextBox x:Name="ProfileName" MaxLength="48" Text="Meu volante" AutomationProperties.Name="Nome do perfil"/><Button x:Name="SaveProfile" Content="Salvar perfil neste computador" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="ProfileSummary" Text="Os perfis guardam ângulo e efeitos. A calibração dos pedais permanece no volante." Foreground="#8294AC" TextWrapping="Wrap" LineHeight="22" Margin="0,24,0,0"/><TextBlock Text="Carregar um perfil prepara os valores para edição. Clique em Aplicar ao volante para enviá-los por USB." Foreground="#8294AC" TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="DevicePage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Arduino Leonardo" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DeviceInfo" Text="Conecte o volante via USB para consultar o firmware." Foreground="#9AAABE" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,24"/><TextBlock Text="Encoder • contagens por volta (CPR)" Foreground="#B7C4D6" Margin="0,0,0,10"/><TextBox x:Name="CprText" MaxLength="5" Text="" AutomationProperties.Name="Contagens por volta do encoder"/><TextBlock Text="Modo da ponte H" Foreground="#B7C4D6" Margin="0,20,0,9"/><ListBox x:Name="BridgeMode" Height="216"><ListBoxItem Content="2PWM + 1DIR"/><ListBoxItem Content="2PWM + 2DIR"/><ListBoxItem Content="1PWM + 1DIR"/><ListBoxItem Content="1PWM + 2DIR"/></ListBox><Button x:Name="ApplyHardware" Content="Aplicar configuração do hardware" Margin="0,18,0,0"/><TextBlock Text="Use os valores correspondentes à montagem elétrica do seu volante." Foreground="#8294AC" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Dispositivo e compatibilidade" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="O Leonardo continua sendo reconhecido pelo Windows com o firmware atual. O aplicativo configura o volante; os jogos recebem os comandos diretamente pelo USB." Foreground="#9AAABE" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,24"/><Button x:Name="WindowsTestDevice" Content="Abrir controladores de jogo do Windows  ↗"/><Border Height="1" Background="#29313F" Margin="0,24"/><StackPanel x:Name="OptionalInputs" Margin="0,0,0,22"/><TextBlock Text="VOLANTE STUDIO  /  1.0.3" FontSize="11" FontWeight="SemiBold" Foreground="#6DAAF5"/><TextBlock Text="Interface independente inspirada em painéis de simulação. Comunicação pelo componente original EMC. Sem alteração do firmware, dos drivers ou da instalação original." Foreground="#8294AC" TextWrapping="Wrap" LineHeight="23" Margin="0,14,0,0"/></StackPanel></Border></Grid>
   </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#C80D1219" BorderBrush="#262E3A" BorderThickness="0,1,0,0" Padding="30,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusTitle" Text="Status do dispositivo" FontSize="12" Foreground="#C4CEDD"/><TextBlock x:Name="StatusDetail" Text="Aguardando o volante pelo USB." FontSize="10" Foreground="#6F7F94" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="DemoToggle" Grid.Column="1" Content="Explorar demonstração" Background="#142F4D" BorderBrush="#448DDA" Foreground="#D5EAFF" FontSize="11" Padding="14,10" Margin="12,0,0,0" VerticalAlignment="Center"/><Button x:Name="FooterProfile" Grid.Column="2" Content="Salvar perfil" Margin="14,0,10,0" Padding="20,10" VerticalAlignment="Center"/><Button x:Name="ApplyButton" Grid.Column="3" Content="Aplicar ao volante  →" Style="{StaticResource Primary}" Padding="23,11" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
 </Border>
</Window>
