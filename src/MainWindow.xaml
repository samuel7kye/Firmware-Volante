      </Grid>
      <StackPanel x:Name="WheelInfoPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="AngleValue" Text="0" FontSize="35" FontWeight="Light"/><TextBlock Text="°" Foreground="#248CFF" FontSize="24" Margin="3,1,0,0"/></StackPanel><TextBlock x:Name="LiveLabel" Text="POSIÇÃO DO VOLANTE" Foreground="#66778D" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,12"/><Button x:Name="CenterButton" Content="⊕   Centralizar direção" Padding="17,7" Foreground="#65AAFB" Background="#101B2A" BorderBrush="#233B57"/></StackPanel>
