    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="V 1.0.3" FontSize="10" Foreground="#515C6B" HorizontalAlignment="Center" Margin="0,0,0,25"/>
    <Grid/>
   </DockPanel>
  </Border>
